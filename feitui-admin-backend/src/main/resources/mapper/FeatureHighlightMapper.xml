<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feitui.mapper.FeatureHighlightMapper">

    <resultMap id="HighlightMap" type="com.feitui.entity.FeatureHighlight">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="color" property="color"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectAll" resultMap="HighlightMap">
        SELECT * FROM t_feature_highlight WHERE status = 1 ORDER BY sort ASC
    </select>

    <insert id="insert" parameterType="com.feitui.entity.FeatureHighlight" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_feature_highlight (name, color, sort, status)
        VALUES (#{name}, #{color}, #{sort}, #{status})
    </insert>

    <update id="updateById" parameterType="com.feitui.entity.FeatureHighlight">
        UPDATE t_feature_highlight
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="color != null">color = #{color},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM t_feature_highlight WHERE id = #{id}
    </delete>
</mapper>
