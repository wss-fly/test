<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feitui.mapper.ContactMapper">

    <resultMap id="ContactMap" type="com.feitui.entity.Contact">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="company" property="company"/>
        <result column="platform" property="platform"/>
        <result column="requirement" property="requirement"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.feitui.entity.Contact" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_contact (name, phone, email, company, platform, requirement, status)
        VALUES (#{name}, #{phone}, #{email}, #{company}, #{platform}, #{requirement}, #{status})
    </insert>

    <select id="selectById" resultMap="ContactMap">
        SELECT * FROM t_contact WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="ContactMap">
        SELECT * FROM t_contact
        <where>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <update id="updateById" parameterType="com.feitui.entity.Contact">
        UPDATE t_contact
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM t_contact WHERE id = #{id}
    </delete>
</mapper>
